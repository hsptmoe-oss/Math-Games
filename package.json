{
  "name": "math-games",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "node copy-www.js",
    "cap:sync": "node copy-www.js && npx cap sync android",
    "cap:open": "npx cap open android",
    "start": "node -e \"require('http').createServer((req,res)=>{let p=decodeURI(req.url.split('?')[0]);if(p==='/')p='/index.html';let f=require('path').join(__dirname,p);let m={'.html':'text/html; charset=utf-8','.js':'text/javascript; charset=utf-8','.css':'text/css; charset=utf-8','.json':'application/json','.png':'image/png','.svg':'image/svg+xml'};require('fs').readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end('404');}else{res.writeHead(200,{'Content-Type':m[require('path').extname(f)]||'application/octet-stream'});res.end(d);}});}).listen(3344,()=>console.log('http://localhost:3344'));\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2"
  }
}
